# ==============================================================================
# Diabetes Expert System - Environment Configuration Template
# ==============================================================================
# Copy this file to .env when starting with the root main.py entry point
# or Docker Compose. backend/run.py reads backend/.env instead; use
# backend/.env.example for that entry point. Vite reads frontend/.env.
# Cloud deployments can configure these variables in their environment.

# ------------------------------------------------------------------------------
# 1. Core Flask & Security
# ------------------------------------------------------------------------------
FLASK_DEBUG=false
DEMO_MODE=true
# Required in production: generate with `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRES_SECONDS=3600
JWT_REFRESH_EXPIRES_SECONDS=604800

# ------------------------------------------------------------------------------
# 2. Database Options (PostgreSQL / SQLite)
# ------------------------------------------------------------------------------
# Option A: Local Docker PostgreSQL
# DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/diabetes_db

# Option B: NEW personal cloud PostgreSQL (Supabase, Neon, Railway, Render)
# DATABASE_URL=postgresql+psycopg://user:password@aws-0-region.pooler.supabase.com:5432/postgres

# Active demo database (replace with a new database you own)
DATABASE_URL=postgresql+psycopg://demo_user:replace-me@127.0.0.1:5432/diabetes_demo

# Database auto-initialization & seeding
DB_AUTO_CREATE=true
SEED_DEMO_DATA=true
RULES_SEED_VERSION=v3

# Keep fallback disabled so this copy never silently uses another database.
REQUIRE_POSTGRES=true
DB_FALLBACK_ENABLED=false
DB_FALLBACK_URL=sqlite:///dev_fallback.db
DB_FALLBACK_AUTO_CREATE=false
DB_FALLBACK_SEED=false

# ------------------------------------------------------------------------------
# 3. Docker PostgreSQL Credentials (used by docker-compose)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_here
POSTGRES_DB=diabetes_demo

# Optional pgAdmin web UI (docker compose --profile tools up -d pgadmin)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me

# ------------------------------------------------------------------------------
# 4. CORS Origins
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,http://localhost,https://your-app.vercel.app

# ------------------------------------------------------------------------------
# 5. Frontend Variables (used during Vite build)
# ------------------------------------------------------------------------------
# For Docker Nginx prod: use "/api" (proxied directly)
# For Vercel hosting: set this in Vercel to your deployed backend URL: "https://your-backend.railway.app/api"
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=20000
VITE_DEMO_MODE=true
VITE_DEMO_LABEL=Independent Demo
